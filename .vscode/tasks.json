{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dx serve (web)",
      "type": "shell",
      "command": "dx",
      "args": ["serve", "--package", "web"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "dx",
        "pattern": {
          "regexp": "^(?!)((.*))$",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": ".*(Serving|serving|Build completed|launching|listening|ready|localhost|8080).*"
        }
      },
      "isBackground": true
    },
