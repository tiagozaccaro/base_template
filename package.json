{
  "name": "base-template",
  "version": "0.1.0",
  "private": true,
  "description": "Dioxus fullstack workspace with CI/CD and branch policy",
  "license": "MIT",
  "scripts": {
    "lint:commit": "commitlint --from origin/main --to HEAD",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "css": "tailwindcss -i packages/web/assets/tailwind.css -o packages/web/assets/tailwind.css --watch",
    "css:build": "tailwindcss -i packages/web/assets/tailwind.css -o packages/web/assets/tailwind.css --minify"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
